# ---------------------------------------------------------------------------
# Configuración del puente serial — copia este archivo a ".env" y ajústalo.
# ---------------------------------------------------------------------------

# URL del backend (API REST).
BACKEND_URL=http://localhost:3000

# Clave de dispositivo (debe coincidir con DEVICE_API_KEY del backend).
DEVICE_API_KEY=CLAVE_DE_API_DEL_ESP8266

# Puerto serial que usa el PUENTE (el OTRO extremo del par virtual VSPD;
# el extremo COMPIM lo usa Proteus). Windows: COM2 | Linux: /dev/pts/... o /dev/ttyUSB0
SERIAL_PORT=COM2

# Baudios (debe coincidir con Serial.begin() del Arduino y con COMPIM).
BAUD_RATE=9600

# Intervalo de sondeo de la API en milisegundos.
POLL_INTERVAL_MS=1000
