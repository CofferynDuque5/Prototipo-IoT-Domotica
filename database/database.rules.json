{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",

    "devices": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$deviceId": {
        ".validate": "newData.hasChildren(['nombre', 'tipo', 'estado', 'gpio'])",
        "estado": { ".validate": "newData.isBoolean()" },
        "gpio": { ".validate": "newData.isNumber()" },
        "online": { ".validate": "newData.isBoolean()" },
        "ultimaActualizacion": { ".validate": "newData.isNumber()" }
      }
    },

    "esp": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "events": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["timestamp"]
    },

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    }
  }
}
