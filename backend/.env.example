# ---------------------------------------------------------------------------
# Configuración del backend — copia este archivo a ".env" y ajusta los valores.
# ---------------------------------------------------------------------------

# Puerto HTTP/WebSocket del servidor
PORT=3000

# Conexión a PostgreSQL.
# Con Docker Compose el host es "db"; en local suele ser "localhost".
DATABASE_URL=postgres://iot_user:iot_password@localhost:5432/iot_domotica

# Secreto para firmar los JWT de sesión (usa una cadena larga y aleatoria).
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
JWT_EXPIRES_IN=7d

# Clave de API para que el ESP8266 acceda a los endpoints de dispositivo.
DEVICE_API_KEY=cambia_esta_clave_del_dispositivo

# Segundos sin telemetría tras los que el ESP se considera desconectado.
ESP_OFFLINE_THRESHOLD_SECONDS=30

# Dispositivo (relé) expuesto por /api/estado y usado por el puente serial.
RELAY_DEVICE_ID=dev_luz_sala
